# SPARQL query template for pulling objects from KG
# Use with VALUES clause for batching multiple IRIs

# Basic pull query for single or multiple IRIs
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?s ?p ?o WHERE {
  VALUES ?s { {iris} }
  ?s ?p ?o .
}
